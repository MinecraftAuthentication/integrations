# An allowlist of specific Minecraft players. No server token needed.
# Prefer UUIDs: names can change hands, UUIDs can't. Names are matched case-insensitively.

{
	mcauth {
		app_id {env.MCAUTH_APP_ID}
		redirect https://example.com/mcauth/callback
		session_key {env.MCAUTH_SESSION_KEY}

		realm staff {
			# several players on one line, UUIDs with or without dashes
			player 069a79f4-44e9-4726-a5be-fca90e38aaf5 853c80ef3c3749fdaa49938b674adae6
			# or one per line, by name
			player Dinnerbone
			player Grumm
		}
	}
}

example.com {
	mcauth_callback /mcauth/callback

	mcauth staff
	reverse_proxy localhost:9000
}
